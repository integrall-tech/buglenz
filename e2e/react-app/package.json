{
  "name": "buglenz-e2e-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "End-to-end check: a minified React 19 app with the official Sentry SDK and source maps against the server (governance/openspec/006-compatibilidade-sdk-atual).",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "run": "node run.mjs"
  },
  "dependencies": {
    "@sentry/react": "11.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@sentry/cli", "esbuild"]
  }
}
